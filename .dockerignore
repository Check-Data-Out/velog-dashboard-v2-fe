# Dockerfile 이 COPY 하는 것: next.config.mjs, ecosystem.config.js, .next/standalone, .next/static, public,
# .env.production(CI 가 생성, 토큰 없음), package.json, pnpm-lock.yaml, pnpm-workspace.yaml
